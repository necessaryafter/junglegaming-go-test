        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jungle-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"jungle\"}, instance)",
          "refId": "InstanceVariable"
        },
        "definition": "label_values(up{job=\"jungle\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
