# Somente desenvolvimento local. O Compose funciona também sem um arquivo .env.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=jungle-local
POSTGRES_MIGRATION_PASSWORD=jungle-migration-local
POSTGRES_RUNTIME_PASSWORD=jungle-runtime-local
KEYCLOAK_PORT=8080
KEYCLOAK_DB_PASSWORD=keycloak-local
KEYCLOAK_ADMIN_PASSWORD=admin-local
LOCALSTACK_PORT=4566

# Aplicação executada no host (exporte estas variáveis antes de go run).
HTTP_ADDRESS=:8081
APP_PORT=8081
DATABASE_URL=postgres://jungle_runtime:jungle-runtime-local@localhost:5432/jungle?sslmode=disable
MIGRATION_DATABASE_URL=postgres://jungle_migrator:jungle-migration-local@localhost:5432/jungle?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
OIDC_ISSUER=http://localhost:8080/realms/jungle
OIDC_AUDIENCE=jungle-api
OIDC_JWKS_URL=http://localhost:8080/realms/jungle/protocol/openid-connect/certs
SQS_REQUESTS_QUEUE=wager-transactions.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# Must cover claim + publication deadlines (minimum 20s; default 60s).
OUTBOX_LEASE_DURATION=60s
